[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://game/features/world/presentation/editor/ui/map_scenario_workspace.gd" id="1_workspace"]

[node name="ScenarioWorkspace" type="PanelContainer"]
script = ExtResource("1_workspace")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="Rows" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Margin/Rows"]
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/Rows/Header"]
text = "Сценарий карты"
theme_override_font_sizes/font_size = 18

[node name="Summary" type="Label" parent="Margin/Rows/Header"]
size_flags_horizontal = 3
text = "0 правил · 0 флагов"
horizontal_alignment = 2

[node name="MapButton" type="Button" parent="Margin/Rows/Header"]
text = "◎ Показать карту"
tooltip_text = "Временно открыть карту; геометрия областей редактируется в режиме «Зоны и точки»"

[node name="Help" type="Label" parent="Margin/Rows"]
text = "Выберите строку правила, условия или действия. Свойства выбранной строки редактируются справа."
autowrap_mode = 2
theme_override_colors/font_color = Color(0.7, 0.73, 0.78, 1)

[node name="Search" type="LineEdit" parent="Margin/Rows"]
placeholder_text = "Поиск в открытом разделе…"
clear_button_enabled = true

[node name="List" type="ItemList" parent="Margin/Rows"]
size_flags_vertical = 3
allow_reselect = true

[node name="EmptyHint" type="Label" parent="Margin/Rows"]
size_flags_vertical = 3
text = "Добавьте первую запись слева"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2
