[node name="ShortcutTooltip" parent="Margin/Row" instance=ExtResource("1_shortcuts")]
layout_mode = 2
shortcuts_text = "Общее\nЛКМ — применить · Shift+ПКМ — обратное действие\nПКМ — камера · СКМ — панорама · Колесо — зум\nWASD/QE — движение камеры · Home — показать всю карту\nCtrl+S — сохранить · Ctrl+Z / Ctrl+Shift+Z — отменить / повторить\n1–3 — режим редактора · Esc — в меню\n\nИнструменты\nShift+колесо или [ ] — размер кисти · Tab — следующий подынструмент\nРельеф: пандус — протянуть ЛКМ между высотами · C — уклон · Shift+ПКМ — удалить\nПодъём: V — форма откоса · Shift+ЛКМ — пипетка · F — выровнять · M — навигация · T — профиль\nПоверхность: B — вариант · U/J — износ / снег\nВода: +/− — уровень · G — взять уровень грунта · F — лёд · I — толщина льда · V/C — течение"
